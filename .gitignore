# 1. Python Cache Files (Auto-generated by Python, no need to share)
__pycache__/
*.py[cod]
*$py.class

# 2. Project Logs & Image Datasets (Local runtime data)
logs/
*.log
*.jpg

# 3. Virtual Environments (Local packages)
venv/
env/
.venv/

# 4. OS/System Generated Files (Mac/Windows hidden files)
.DS_Store
Thumbs.db
desktop.ini

# 5. IDE / Editor Configurations (VSCode, PyCharm, etc.)
.vscode/
.idea/